+// ======================================================
+// UPLOAD SCREENSHOT BATCH
+// Used by the browser's 5-minute upload queue
+// (flushScreenshotUploadQueue in src/lib/localStorageService.ts).
+// Without this route screenshots never leave the browser when you run
+// the local server, so Admin reports show 0 screenshots.
+// ======================================================
+
+const batchUpload =
+  multer({
+    storage:
+      multer.memoryStorage(),
+
+    limits: {
+      fileSize:
+        25 * 1024 * 1024,
+
+      files: 100,
+    },
+  });
+
+app.post(
+  '/api/upload-screenshot-batch',
+  batchUpload.array(
+    'files'
+  ),
+  (
+    req,
+    res
+  ) => {
+    try {
+      let metadata = [];
+
+      try {
+        const parsed =
+          JSON.parse(
+            String(
+              req.body
+                ?.metadata ||
+                '[]'
+            )
+          );
+
+        metadata =
+          Array.isArray(
+            parsed
+          )
+            ? parsed
+            : [];
+      } catch {
+        return res
+          .status(400)
+          .json({
+            success: false,
+            error:
+              'Invalid screenshot batch metadata.',
+          });
+      }
+
+      const files =
+        Array.isArray(
+          req.files
+        )
+          ? req.files
+          : [];
+
+      if (
+        !files.length ||
+        files.length !==
+          metadata.length
+      ) {
+        return res
+          .status(400)
+          .json({
+            success: false,
+            error:
+              'Screenshot batch is empty or metadata does not match the file count.',
+          });
+      }
+
+      const uploadedIds = [];
+      const failed = [];
+
+      files.forEach(
+        (
+          file,
+          index
+        ) => {
+          const item =
+            metadata[index] ||
+            {};
+
+          const queueId =
+            String(
+              item.queueId ||
+                ''
+            ).trim();
+
+          const employeeId =
+            String(
+              item.employeeId ||
+                ''
+            ).trim();
+
+          try {
+            if (
+              !queueId ||
+              !employeeId
+            ) {
+              throw new Error(
+                'employeeId and queueId are required.'
+              );
+            }
+
+            const employee =
+              findEmployeeById(
+                employeeId
+              );
+
+            if (
+              !employee
+            ) {
+              throw new Error(
+                'Employee not found.'
+              );
+            }
+
+            const dateKey =
+              isValidDateKey(
+                item.dateKey
+              )
+                ? item.dateKey
+                : dateKeyNow();
+
+            const folder =
+              employeeDateFolder(
+                employee,
+                dateKey
+              );
+
+            fs.mkdirSync(
+              folder,
+              {
+                recursive: true,
+              }
+            );
+
+            const extension =
+              path.extname(
+                String(
+                  item.fileName ||
+                    file.originalname ||
+                    ''
+                )
+              ) || '.webp';
+
+            const fileName =
+              safeSegment(
+                item.fileName,
+                `Screen_${Date.now()}_${index}${extension}`
+              );
+
+            fs.writeFileSync(
+              path.join(
+                folder,
+                fileName
+              ),
+              file.buffer
+            );
+
+            uploadedIds.push(
+              queueId
+            );
+          } catch (
+            error
+          ) {
+            failed.push({
+              queueId,
+              error:
+                error.message ||
+                'Screenshot upload failed.',
+            });
+          }
+        }
+      );
+
+      console.log(
+        `📸 Screenshot batch saved: ${uploadedIds.length} ok, ${failed.length} failed`
+      );
+
+      return res
+        .status(
+          uploadedIds.length ||
+            !failed.length
+            ? 200
+            : 500
+        )
+        .json({
+          success:
+            uploadedIds.length >
+              0 ||
+            failed.length === 0,
+
+          uploadedIds,
+
+          uploadedCount:
+            uploadedIds.length,
+
+          failedCount:
+            failed.length,
+
+          failed,
+        });
+    } catch (
+      error
+    ) {
+      console.error(
+        'Upload screenshot batch error:',
+        error
+      );
+
+      return res
+        .status(500)
+        .json({
+          success: false,
+          error:
+            error.message,
+        });
+    }
+  }
+);
+
 // ======================================================
 // STATIC SCREENSHOT FILES
 // ======================================================
