{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nikhil-workmonitor-demo",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nikhil-workmonitor-demo-db",
      "database_id": "04e1fc0e-fcd0-4b51-b64a-404ca3afac3f"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SCREENSHOTS",
      "id": "bd8d84f6901949bca164580c9522ab9a"
    }
  ]
}